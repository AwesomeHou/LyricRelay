<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LyricRelay.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../packages/protocol/csharp/LyricRelay.Protocol.csproj" />
    <ProjectReference Include="src/Core/LyricRelay.Core.csproj" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="src/Core/**/*.cs" />
    <Compile Remove="src/Lyrics/**/*.cs" />
    <Compile Remove="src/Timeline/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="**/obj/**/*.cs" />
  </ItemGroup>
</Project>
