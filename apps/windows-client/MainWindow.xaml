<Window x:Class="LyricRelay.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyricRelay"
        Width="520"
        Height="620"
        MinWidth="420"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="240" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="LyricRelay" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,8,0,16" Text="手机听，电脑看。此窗口只用于配对和设置，歌词显示在 Windows 任务栏。" TextWrapping="Wrap" />
        <Border Grid.Row="2" BorderBrush="#D0D0D0" BorderThickness="1" Padding="12">
            <Image x:Name="PairingQr" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="PairingText" Text="正在生成配对二维码…" TextWrapping="Wrap" />
            <Button Content="刷新二维码" Width="120" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnRefreshPairing" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock x:Name="ConnectionText" VerticalAlignment="Center" Text="连接：未启动" />
                <Button Content="刷新连接" Margin="12,0,0,0" Padding="10,2" Click="OnRefreshConnection" />
            </StackPanel>
            <TextBlock x:Name="LyricsText" Margin="0,4,0,0" Text="歌词来源：LRCLIB" />
        </StackPanel>
        <GroupBox Grid.Row="4" Header="必要设置" Margin="0,20,0,0">
            <StackPanel Margin="12">
                <CheckBox x:Name="ShowLyrics" Content="显示任务栏歌词" IsChecked="True" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
                <CheckBox x:Name="StartWithWindows" Margin="0,8,0,0" Content="开机启动" IsChecked="False" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
                <CheckBox x:Name="AutoConnect" Margin="0,8,0,0" Content="自动连接已配对手机" IsChecked="True" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
                <CheckBox x:Name="DoubleLine" Margin="0,8,0,0" Content="显示下一行歌词" IsChecked="False" Checked="OnSettingsChanged" Unchecked="OnSettingsChanged" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock VerticalAlignment="Center" Text="字号" />
                    <Slider x:Name="FontSizeSlider" Margin="12,0,0,0" Width="180" Minimum="10" Maximum="32" Value="16" ValueChanged="OnSettingsChanged" />
                    <TextBlock x:Name="FontSizeValue" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock VerticalAlignment="Center" Text="时间偏移 (ms)" />
                    <Slider x:Name="OffsetSlider" Margin="12,0,0,0" Width="180" Minimum="-5000" Maximum="5000" TickFrequency="100" Value="0" ValueChanged="OnSettingsChanged" />
                    <TextBlock x:Name="OffsetValue" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock VerticalAlignment="Center" Text="对齐" />
                    <ComboBox x:Name="AlignmentBox" Margin="12,0,0,0" Width="100" SelectionChanged="OnSettingsChanged">
                        <ComboBoxItem Content="Left" />
                        <ComboBoxItem Content="Center" IsSelected="True" />
                        <ComboBoxItem Content="Right" />
                    </ComboBox>
                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Text="字重" />
                    <ComboBox x:Name="WeightBox" Margin="8,0,0,0" Width="80" SelectionChanged="OnSettingsChanged">
                        <ComboBoxItem Content="400" />
                        <ComboBoxItem Content="600" IsSelected="True" />
                        <ComboBoxItem Content="700" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock VerticalAlignment="Center" Text="颜色" />
                    <TextBox x:Name="ColorBox" Margin="12,0,0,0" Width="100" Text="#FFFFFF" TextChanged="OnSettingsTextChanged" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock VerticalAlignment="Center" Text="字体" />
                    <TextBox x:Name="FontFamilyBox" Margin="12,0,0,0" Width="160" Text="Segoe UI" TextChanged="OnSettingsTextChanged" />
                </StackPanel>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
